[Unit]
Description=Read-only IMAP proxy
Documentation=https://github.com/arj/imap-readonly-proxy
After=network-online.target
Wants=network-online.target
# Do not start until the administrator has written a configuration.
ConditionPathExists=/etc/imap-readonly-proxy/config.toml

[Service]
Type=simple
User=imap-readonly-proxy
Group=imap-readonly-proxy
ExecStart=/usr/bin/imap-readonly-proxy -config /etc/imap-readonly-proxy/config.toml
Restart=on-failure
RestartSec=5s

# Allow binding to port 993 without running as root.
AmbientCapabilities=CAP_NET_BIND_SERVICE
CapabilityBoundingSet=CAP_NET_BIND_SERVICE

# Sandboxing
NoNewPrivileges=yes
ProtectSystem=strict
ProtectHome=yes
PrivateTmp=yes
PrivateDevices=yes
ProtectKernelTunables=yes
ProtectKernelModules=yes
ProtectKernelLogs=yes
ProtectControlGroups=yes
ProtectClock=yes
ProtectHostname=yes
ProtectProc=invisible
ProcSubset=pid
RestrictAddressFamilies=AF_INET AF_INET6 AF_UNIX
RestrictNamespaces=yes
RestrictRealtime=yes
RestrictSUIDSGID=yes
LockPersonality=yes
MemoryDenyWriteExecute=yes
RemoveIPC=yes
SystemCallArchitectures=native
SystemCallFilter=@system-service
SystemCallFilter=~@privileged
SystemCallErrorNumber=EPERM
UMask=0077

[Install]
WantedBy=multi-user.target
